    function addPartRow() {
      const tbody = document.getElementById('multi-parts-tbody');
      if (!tbody) return;
      const rowCount = tbody.rows.length + 1;

      let partOptions = '<option value="">-- เลือกรหัสอะไหล่ --</option>';
      masterParts.forEach(p => {
        partOptions += `<option value="${p.id}">${p.id} | ${p.name}</option>`;
      });

      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-50';
      tr.innerHTML = `
        <td class="p-2.5 text-center font-bold text-slate-500 row-index">${rowCount}</td>
        <td class="p-2.5">
          <select required onchange="onPartSelected(this)" class="part-select w-full border rounded p-1.5 bg-white text-xs">
            ${partOptions}
          </select>
        </td>
        <td class="p-2.5">
          <input type="text" readonly class="part-name w-full border rounded p-1.5 bg-slate-100 text-slate-600 text-xs" placeholder="แสดงอัตโนมัติเมื่อเลือกรหัส">
        </td>
        <td class="p-2.5">
          <input type="text" maxlength="15" class="part-imei w-full border rounded p-1.5 text-xs" placeholder="IMEI อะไหล่/เครื่อง">
        </td>
        <td class="p-2.5 text-center font-bold text-slate-700 current-stock-cell">-</td>
        <td class="p-2.5 text-center">
          <input type="number" min="1" value="1" required class="part-qty w-20 border rounded p-1.5 text-center text-xs font-semibold">
        </td>
        <td class="p-2.5 text-center">
          <button type="button" onclick="removePartRow(this)" class="text-red-500 hover:text-red-700 p-1">
            <i class="fa-solid fa-trash-can"></i>
