    function handleCatalogSubmit(e) {
      e.preventDefault();
      const mode = document.getElementById('cat-mode').value;
      const id = document.getElementById('cat-id').value.trim().toUpperCase();
      const name = document.getElementById('cat-name').value.trim();
      const model = document.getElementById('cat-model').value.trim() || "-";
      const category = document.getElementById('cat-category').value;
      const minStock = parseInt(document.getElementById('cat-min').value, 10) || 0;
      const costThb = parseFloat(document.getElementById('cat-cost').value) || 0;
      const price = parseFloat(document.getElementById('cat-price').value) || 0;

      if (mode === 'ADD') {
        const exist = masterParts.find(p => p.id === id);
        if (exist) {
          alert(`รหัสอะไหล่ ${id} มีอยู่แล้วในระบบ`);
          return;
        }
        masterParts.push({ id, name, model, category, minStock, costThb, price });
        alert(`เพิ่มสินค้า "${name}" (${id}) เรียบร้อยแล้ว`);
      } else {
        const idx = masterParts.findIndex(p => p.id === id);
        if (idx !== -1) {
          masterParts[idx] = { ...masterParts[idx], id, name, model, category, minStock, costThb, price };
          alert(`อัปเดตข้อมูลอะไหล่ ${id} สำเร็จ`);
        }
      }

      saveAll();
      resetCatalogForm();
      renderCatalogTable();
      renderStockTable();
      populateUrgentPartsDropdown();
    }

    function editCatalogItem(partId) {
      const part = masterParts.find(p => p.id === partId);
      if (!part) return;

      document.getElementById('cat-mode').value = 'EDIT';
      document.getElementById('cat-id').value = part.id;
      document.getElementById('cat-id').readOnly = true;
      document.getElementById('cat-id').classList.add('bg-slate-200');
      document.getElementById('cat-name').value = part.name;
      document.getElementById('cat-model').value = part.model || '';
      document.getElementById('cat-category').value = part.category || 'อื่นๆ (Others)';
      document.getElementById('cat-min').value = part.minStock;
      document.getElementById('cat-cost').value = part.costThb || 0;
      document.getElementById('cat-price').value = part.price || 0;

      document.getElementById('catalog-form-title').innerText = `แก้ไขอะไหล่: ${part.id}`;
      document.getElementById('btn-submit-catalog').innerHTML = `<i class="fa-solid fa-pen-to-square"></i> บันทึกการแก้ไข`;
    }

    function deleteCatalogItem(partId) {
      if (confirm(`คุณแน่ใจว่าต้องการลบรหัส ${partId} ออกจากระบบ?`)) {
        masterParts = masterParts.filter(p => p.id !== partId);
        saveAll();
        renderCatalogTable();
        renderStockTable();
        populateUrgentPartsDropdown();
      }
    }

    function resetCatalogForm() {
      document.getElementById('catalog-form').reset();
