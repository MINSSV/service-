    function onPartSelected(select) {
      const tr = select.closest('tr');
      const partId = select.value;
      const nameInput = tr.querySelector('.part-name');
      const stockCell = tr.querySelector('.current-stock-cell');

      if (!partId) {
        nameInput.value = '';
        stockCell.innerText = '-';
        return;
      }

      const part = masterParts.find(p => p.id === partId);
      const stockMap = calculateStockBalance();
      const currentQty = stockMap[partId] ? stockMap[partId].currentStock : 0;

      nameInput.value = part ? part.name : '';
      stockCell.innerText = currentQty;
      stockCell.className = `p-2.5 text-center font-bold ${currentQty <= 0 ? 'text-red-600' : 'text-slate-800'}`;
    }

    function previewBillImage(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          currentVoucherBillBase64 = e.target.result;
          document.getElementById('v-bill-img-thumb').src = e.target.result;
          document.getElementById('v-bill-preview-box').classList.remove('hidden');
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    function resetVoucherForm() {
      document.getElementById('voucher-form').reset();
      currentVoucherBillBase64 = null;
      document.getElementById('v-bill-preview-box').classList.add('hidden');
      initVoucherForm();
    }

    function handleVoucherSubmit(e) {
      e.preventDefault();
      const mainType = document.getElementById('v-main-type').value;
      const subType = document.getElementById('v-sub-type').value;
      const sourceBranch = document.getElementById('v-source-branch').value;
      const destBranch = document.getElementById('v-dest-branch').value;
      const date = document.getElementById('v-date').value;
      const refNo = document.getElementById('v-ref-no').value || `REF-${Date.now().toString().slice(-4)}`;
      const docNo = document.getElementById('voucher-code-preview').innerText;

      const tbody = document.getElementById('multi-parts-tbody');
      const items = [];
      const stockBalance = calculateStockBalance();

      for (let i = 0; i < tbody.rows.length; i++) {
        const row = tbody.rows[i];
        const partId = row.querySelector('.part-select').value;
        const partName = row.querySelector('.part-name').value;
        const imei = row.querySelector('.part-imei').value;
        const qty = parseInt(row.querySelector('.part-qty').value, 10);

        if (!partId) {
          alert(`กรุณาเลือกรหัสอะไหล่ในแถวที่ ${i + 1}`);
          return;
        }

        if (mainType === 'OUT') {
          const avail = stockBalance[partId] ? stockBalance[partId].currentStock : 0;
          if (qty > avail) {
            alert(`ไม่สามารถตัดสต็อก ${partId} จำนวน ${qty} ชิ้นได้ เนื่องจากมีคงเหลือเพียง ${avail} ชิ้น`);
            return;
          }
        }
        items.push({ partId, partName, imei, qty });
      }

      transactions.unshift({
        docNo, date, sourceBranch, destBranch, mainType, subType, refNo,
        billImg: currentVoucherBillBase64,
        createdBy: currentUser.name,
        items
      });

      if (subType === 'CLAIM_IN_WARRANTY' || subType === 'CLAIM_OUT_WARRANTY') {
        const partsSummary = items.map(it => `${it.partId} (${it.qty} ชิ้น)`).join(', ');
        serviceJobs.unshift({
          jobNo: refNo,
          date,
          branch: sourceBranch,
          imei: items[0] ? items[0].imei : '-',
          issue: `งานซ่อมเปลี่ยนอะไหล่ [${subType === 'CLAIM_IN_WARRANTY' ? 'ในประกัน' : 'นอกประกัน'}]`,
          warranty: subType === 'CLAIM_IN_WARRANTY' ? 'IN_WARRANTY' : 'OUT_WARRANTY',
          hasPartReplacement: true,
          partsUsed: partsSummary
        });
      }

      saveAll();
      alert(`บันทึกเอกสาร ${docNo} สำเร็จเรียบร้อย! ปรับปรุงยอดสต็อกแล้ว`);
      resetVoucherForm();
      renderStockTable();
      renderDashboard();
      switchTab('stock');
    }

