    // -------------------------------------------------------------
    // DASHBOARD & CHARTS
    // -------------------------------------------------------------
    function renderDashboard() {
      const filterBranch = document.getElementById('dash-branch-filter')?.value || 'ALL';
      const jobs = serviceJobs.filter(j => filterBranch === 'ALL' || j.branch === filterBranch);

      const total = jobs.length;
      const inWty = jobs.filter(j => j.warranty === 'IN_WARRANTY').length;
      const outWty = jobs.filter(j => j.warranty === 'OUT_WARRANTY').length;
      const replaced = jobs.filter(j => j.hasPartReplacement).length;
      const notReplaced = total - replaced;

      if (document.getElementById('kpi-total-jobs')) document.getElementById('kpi-total-jobs').innerText = total;
      if (document.getElementById('kpi-in-warranty')) document.getElementById('kpi-in-warranty').innerText = inWty;
      if (document.getElementById('kpi-in-warranty-pct')) document.getElementById('kpi-in-warranty-pct').innerText = total ? `${Math.round((inWty/total)*100)}%` : '0%';
      if (document.getElementById('kpi-out-warranty')) document.getElementById('kpi-out-warranty').innerText = outWty;
      if (document.getElementById('kpi-out-warranty-pct')) document.getElementById('kpi-out-warranty-pct').innerText = total ? `${Math.round((outWty/total)*100)}%` : '0%';
      if (document.getElementById('kpi-parts-replaced')) document.getElementById('kpi-parts-replaced').innerText = replaced;
      if (document.getElementById('kpi-no-parts')) document.getElementById('kpi-no-parts').innerText = `ไม่เปลี่ยนอะไหล่: ${notReplaced} งาน`;

      if (document.getElementById('legend-in')) document.getElementById('legend-in').innerText = `${inWty} งาน`;
      if (document.getElementById('legend-out')) document.getElementById('legend-out').innerText = `${outWty} งาน`;

      const ctxBar = document.getElementById('branchJobChart')?.getContext('2d');
      if (ctxBar) {
        const branchLabels = filterBranch === 'ALL' ? BRANCHES : [filterBranch];
        const partsData = branchLabels.map(b => serviceJobs.filter(j => j.branch === b && j.hasPartReplacement).length);
        const noPartsData = branchLabels.map(b => serviceJobs.filter(j => j.branch === b && !j.hasPartReplacement).length);

        if (branchChartInstance) branchChartInstance.destroy();
        branchChartInstance = new Chart(ctxBar, {
          type: 'bar',
          data: {
            labels: branchLabels,
            datasets: [
              { label: 'เปลี่ยนอะไหล่', data: partsData, backgroundColor: '#6366f1', borderRadius: 4 },
              { label: 'ไม่เปลี่ยนอะไหล่', data: noPartsData, backgroundColor: '#cbd5e1', borderRadius: 4 }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } }
          }
        });
      }

      const ctxDonut = document.getElementById('warrantyDoughnutChart')?.getContext('2d');
      if (ctxDonut) {
        if (warrantyChartInstance) warrantyChartInstance.destroy();
        warrantyChartInstance = new Chart(ctxDonut, {
          type: 'doughnut',
          data: {
            labels: ['ในประกัน', 'นอกประกัน'],
            datasets: [{ data: [inWty, outWty], backgroundColor: ['#10b981', '#f59e0b'] }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            cutout: '70%'
          }
        });
      }
    }

    // -------------------------------------------------------------
    // USER MANAGEMENT & MODALS
    // -------------------------------------------------------------
    function openUserModal() {
      if (!currentUser || !currentUser.isAdmin) {
        alert('เฉพาะผู้ดูแลระบบ (Admin) เท่านั้นที่สามารถเข้าถึงส่วนนี้ได้');
        return;
      }
      renderStaffTable();
      document.getElementById('user-mgmt-modal').classList.remove('hidden');
    }

    function closeUserModal() {
      document.getElementById('user-mgmt-modal').classList.add('hidden');
    }

    function renderStaffTable() {
      const tbody = document.getElementById('staff-table-tbody');
      if (!tbody) return;
      tbody.innerHTML = '';
      users.forEach(u => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 border-b';
        
        const perms = [];
        if (u.permissions?.dash) perms.push('แดชบอร์ด');
        if (u.permissions?.stock) perms.push('สต็อก');
        if (u.permissions?.catalog) perms.push('แคตตาล็อก');
        if (u.permissions?.voucher) perms.push('ใบเบิก');
        if (u.permissions?.bills) perms.push('ดูบิล');

        tr.innerHTML = `
          <td class="p-2.5">
            <div class="font-bold text-slate-800">${u.name}</div>
            <div class="text-[11px] text-slate-400 font-mono">@${u.username} ${u.isAdmin ? '<span class="text-amber-600 font-bold">[Admin]</span>' : ''}</div>
          </td>
          <td class="p-2.5 text-slate-600">${u.branch}</td>
          <td class="p-2.5 text-[11px] text-slate-500">${perms.join(', ')}</td>
          <td class="p-2.5 text-center">
            ${u.isAdmin ? '-' : `
              <button onclick="editStaff('${u.id}')" class="text-indigo-600 p-1 hover:text-indigo-800"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="deleteStaff('${u.id}')" class="text-red-500 p-1 hover:text-red-700 ml-1"><i class="fa-solid fa-trash-can"></i></button>
            `}
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function handleSaveStaff(e) {
      e.preventDefault();
      const editId = document.getElementById('staff-edit-id').value;
      const name = document.getElementById('staff-name').value;
      const username = document.getElementById('staff-username').value;
      const password = document.getElementById('staff-password').value;
      const branch = document.getElementById('staff-branch').value;
      const role = document.getElementById('staff-role').value || 'เจ้าหน้าที่สาขา';

      const permissions = {
        dash: document.getElementById('perm-dash').checked,
        stock: document.getElementById('perm-stock').checked,
        catalog: document.getElementById('perm-catalog').checked,
        voucher: document.getElementById('perm-voucher').checked,
        bills: document.getElementById('perm-bills').checked,
        urg: document.getElementById('perm-urg').checked,
        rep: document.getElementById('perm-rep').checked,
        export: document.getElementById('perm-export').checked
      };

      if (editId) {
        const idx = users.findIndex(u => u.id === editId);
        if (idx !== -1) {
          users[idx].name = name;
          users[idx].username = username;
          users[idx].password = password;
          users[idx].branch = branch;
          users[idx].role = role;
          users[idx].permissions = permissions;
        }
      } else {
        users.push({
          id: `USR-${Math.floor(100 + Math.random() * 900)}`,
          username, password, name, branch, role,
          isAdmin: false,
          permissions
        });
      }

      saveAll();
      resetStaffForm();
      renderStaffTable();
      alert('บันทึกข้อมูลพนักงานเรียบร้อย');
    }

    function editStaff(userId) {
      const u = users.find(x => x.id === userId);
      if (!u) return;

      document.getElementById('staff-edit-id').value = u.id;
      document.getElementById('staff-name').value = u.name;
      document.getElementById('staff-username').value = u.username;
      document.getElementById('staff-password').value = u.password;
      document.getElementById('staff-branch').value = u.branch;
      document.getElementById('staff-role').value = u.role;

      document.getElementById('perm-dash').checked = !!u.permissions?.dash;
      document.getElementById('perm-stock').checked = !!u.permissions?.stock;
      document.getElementById('perm-catalog').checked = !!u.permissions?.catalog;
      document.getElementById('perm-voucher').checked = !!u.permissions?.voucher;
      document.getElementById('perm-bills').checked = !!u.permissions?.bills;
      document.getElementById('perm-urg').checked = !!u.permissions?.urg;
      document.getElementById('perm-rep').checked = !!u.permissions?.rep;
      document.getElementById('perm-export').checked = !!u.permissions?.export;

      document.getElementById('user-form-title').innerText = `แก้ไข: ${u.name}`;
    }

    function deleteStaff(userId) {
      if (confirm('คุณแน่ใจว่าต้องการลบบัญชีนี้?')) {
        users = users.filter(u => u.id !== userId);
        saveAll();
        renderStaffTable();
      }
    }

    function resetStaffForm() {
      document.getElementById('staff-form').reset();
      document.getElementById('staff-edit-id').value = '';
      document.getElementById('user-form-title').innerText = 'เพิ่มบัญชีพนักงานใหม่';
    }

    function openSwitchAccountModal() {
      const list = document.getElementById('switch-account-list');
      if (!list) return;
      list.innerHTML = '';
      users.forEach(u => {
        const div = document.createElement('div');
        div.className = "flex items-center justify-between p-3 rounded-lg border border-slate-200 hover:bg-indigo-50 cursor-pointer transition";
        div.onclick = () => {
          currentUser = u;
          closeSwitchAccountModal();
          applyUserSession();
          alert(`สลับไปยังบัญชี "${u.name}" เรียบร้อยแล้ว`);
        };
        div.innerHTML = `
          <div>
            <div class="font-bold text-xs text-slate-800">${u.name} ${u.id === currentUser?.id ? '<span class="text-emerald-600 font-bold">(ปัจจุบัน)</span>' : ''}</div>
            <div class="text-[10px] text-slate-500">${u.role} &bull; ${u.branch}</div>
          </div>
          <span class="text-xs text-indigo-600 font-semibold">เลือก &rarr;</span>
        `;
        list.appendChild(div);
      });
      document.getElementById('switch-account-modal').classList.remove('hidden');
    }

    function closeSwitchAccountModal() {
      document.getElementById('switch-account-modal').classList.add('hidden');
    }
  </script>
</body>
</html>
