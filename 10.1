    // -------------------------------------------------------------
    // EXCEL IMPORT & CATALOG
    // -------------------------------------------------------------
    function importPartsExcel(input) {
      const file = input.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheetName = workbook.SheetNames[0];
          const worksheet = workbook.Sheets[firstSheetName];
          const rows = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

          if (rows.length < 2) {
            alert("ไฟล์ Excel ไม่มีข้อมูลสินค้า");
            return;
          }

          const header = rows[0].map(h => String(h || '').trim());
          const colCode = header.findIndex(h => h.includes("物料编码") || h.includes("Part ID") || h.includes("รหัส"));
          const colName = header.findIndex(h => h.includes("货品名称") || h.includes("Name") || h.includes("ชื่อ"));
          const colCostUsd = header.findIndex(h => h.includes("进货价 (美金)") || h.includes("美金"));
          const colCostThb = header.findIndex(h => h.includes("进货价泰铢") || h.includes("泰铢"));
          const colPriceEx = header.findIndex(h => h.includes("零售价 (不含税)"));
          const colPriceInc = header.findIndex(h => h.includes("零售价 (含税)"));

          if (colCode === -1 || colName === -1) {
            alert("รูปแบบหัวตารางไม่ถูกต้อง: จำเป็นต้องมีคอลัมน์ '物料编码' และ '货品名称'");
            return;
          }

          let countSuccess = 0;
          for (let i = 1; i < rows.length; i++) {
            const row = rows[i];
            const partId = String(row[colCode] || '').trim();
            const partName = String(row[colName] || '').trim();

            if (!partId || !partName) continue;

            const costUsd = colCostUsd !== -1 ? parseFloat(row[colCostUsd]) || 0 : 0;
            const costThb = colCostThb !== -1 ? parseFloat(row[colCostThb]) || 0 : 0;
            const priceExcl = colPriceEx !== -1 ? parseFloat(row[colPriceEx]) || 0 : 0;
            const priceIncl = colPriceInc !== -1 ? parseFloat(row[colPriceInc]) || 0 : 0;

            const existingIdx = masterParts.findIndex(p => p.id === partId);
            const partObj = {
              id: partId,
              name: partName,
              model: "-",
              category: "อะไหล่แท้",
              minStock: 3,
              costUsd: costUsd,
              costThb: costThb,
              priceExcl: priceExcl,
              price: priceIncl || costThb
            };

            if (existingIdx !== -1) {
              masterParts[existingIdx] = { ...masterParts[existingIdx], ...partObj };
            } else {
              masterParts.push(partObj);
            }
            countSuccess++;
          }

          saveAll();
          renderCatalogTable();
          renderStockTable();
          populateUrgentPartsDropdown();
          input.value = "";

          alert(`นำเข้าข้อมูลอะไหล่จากไฟล์ Excel สำเร็จเรียบร้อย ${countSuccess} รายการ!`);
        } catch (err) {
          console.error(err);
          alert("เกิดข้อผิดพลาดในการประมวลผลไฟล์ Excel: " + err.message);
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function renderCatalogTable() {
      const tbody = document.getElementById('catalog-table-tbody');
      if (!tbody) return;
      tbody.innerHTML = '';
