    function receiveUrgentPart(urgentId) {
      const item = urgentList.find(u => u.id === urgentId);
      if (!item) return;

      if (confirm(`ยืนยันการรับอะไหล่ด่วนรหัส ${item.partId} เข้าสต็อกสาขา ${item.branch}?`)) {
        transactions.unshift({
          docNo: `DOC-URG-${Math.floor(100 + Math.random() * 900)}`,
          date: new Date().toISOString().split('T')[0],
          sourceBranch: "สำนักงานใหญ่ (HQ ประเทศไทย)",
          destBranch: item.branch,
          mainType: "IN",
          subType: "HQ_DIRECT",
          refNo: item.id,
          billImg: null,
          createdBy: currentUser.name,
          items: [{
            partId: item.partId,
            partName: item.partName,
            imei: item.imei,
            qty: item.qty
          }]
        });

        urgentList = urgentList.filter(u => u.id !== urgentId);
        saveAll();
        renderUrgentTable();
        renderStockTable();
        alert(`รับอะไหล่ ${item.partId} เข้าสต็อกเรียบร้อยแล้ว`);
      }
    }

