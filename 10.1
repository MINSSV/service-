<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>After-Sales Service & Spare Parts Management System</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- SheetJS (xlsx) CDN อ่านไฟล์ Excel -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Prompt', sans-serif; }
    .badge { padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Header Bar -->
  <header class="bg-indigo-800 text-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center space-x-3">
        <div class="bg-white text-indigo-800 p-2 rounded-lg font-bold shadow">
          <i class="fa-solid fa-screwdriver-wrench text-xl"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-bold tracking-tight">After-Service Center Pro</h1>
            <span class="bg-indigo-900 border border-indigo-700 text-[10px] px-2 py-0.5 rounded-full text-indigo-200">v3.1 Fix</span>
          </div>
          <p class="text-xs text-indigo-200">ระบบบริหารงานซ่อม, สต็อก Real-time, นำเข้า Excel & ตรวจสอบรูปบิล</p>
        </div>
      </div>

      <!-- User Profile Controls -->
      <div class="flex items-center gap-3">
        <div class="bg-indigo-900/80 px-3 py-1.5 rounded-lg border border-indigo-700 flex items-center gap-3">
          <div class="text-right">
            <div class="text-xs font-semibold" id="top-username">Super Admin</div>
            <div class="text-[10px] text-indigo-300" id="top-userrole">ผู้ดูแลระบบสูงสุด</div>
          </div>
          <span class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-xs" id="top-useravatar">SA</span>
        </div>
        
        <button onclick="openUserModal()" id="btn-admin-manage" class="bg-amber-500 hover:bg-amber-600 text-white text-xs px-3 py-2 rounded-lg font-medium shadow flex items-center gap-1.5 transition">
          <i class="fa-solid fa-users-gear"></i> จัดการพนักงาน & สิทธิ์
        </button>
        <button onclick="openSwitchAccountModal()" class="bg-indigo-700 hover:bg-indigo-600 border border-indigo-500 text-white text-xs px-3 py-2 rounded-lg font-medium shadow flex items-center gap-1.5 transition">
          <i class="fa-solid fa-right-left"></i> สลับบัญชี
        </button>
      </div>
    </div>
  </header>

  <!-- Navigation Menu Bar -->
  <nav class="bg-white border-b border-slate-200 shadow-sm sticky top-[61px] z-40">
    <div class="max-w-7xl mx-auto px-4 flex space-x-2 overflow-x-auto py-2" id="nav-container">
      <!-- Dynamic Tabs loaded via JS -->
    </div>
  </nav>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full">

    <!-- TAB 1: DASHBOARD -->
    <section id="view-dashboard" class="space-y-6 hidden">
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-chart-line text-indigo-600"></i> สรุปผลงานซ่อมศูนย์บริการ
          </h2>
          <p class="text-xs text-slate-500">ข้อมูลแยกตามสาขา, สิทธิการรับประกัน, และสถานะการเปลี่ยนอะไหล่</p>
        </div>
        <div class="flex items-center gap-3">
          <select id="dash-branch-filter" onchange="renderDashboard()" class="text-sm border border-slate-300 rounded-lg px-3 py-1.5 bg-slate-50 focus:ring-2 focus:ring-indigo-400">
            <option value="ALL">ทุกสาขา (All Branches)</option>
            <option value="สำนักงานใหญ่ (HQ ประเทศไทย)">สำนักงานใหญ่ (HQ ประเทศไทย)</option>
            <option value="สาขาเวียงจันทน์">สาขาเวียงจันทน์</option>
            <option value="สาขาขอนแก่น">สาขาขอนแก่น</option>
            <option value="สาขาเชียงใหม่">สาขาเชียงใหม่</option>
            <option value="สาขากรุงเทพฯ">สาขากรุงเทพฯ</option>
          </select>
        </div>
      </div>

      <!-- KPI Summary Cards -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-medium text-slate-500 uppercase">ยอดงานซ่อมทั้งหมด</p>
            <p id="kpi-total-jobs" class="text-2xl font-bold text-slate-800 mt-1">0</p>
            <p class="text-xs text-slate-400 mt-0.5">รวมทุกประเภทงาน</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-wrench"></i>
          </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-medium text-slate-500 uppercase">งานซ่อมในประกัน</p>
            <p id="kpi-in-warranty" class="text-2xl font-bold text-emerald-600 mt-1">0</p>
            <p id="kpi-in-warranty-pct" class="text-xs text-emerald-500 mt-0.5">0%</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-medium text-slate-500 uppercase">งานซ่อมนอกประกัน</p>
            <p id="kpi-out-warranty" class="text-2xl font-bold text-amber-600 mt-1">0</p>
            <p id="kpi-out-warranty-pct" class="text-xs text-amber-500 mt-0.5">0%</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-circle-exclamation"></i>
          </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-medium text-slate-500 uppercase">งานที่มีการเปลี่ยนอะไหล่</p>
            <p id="kpi-parts-replaced" class="text-2xl font-bold text-purple-600 mt-1">0</p>
            <p id="kpi-no-parts" class="text-xs text-slate-400 mt-0.5">ไม่เปลี่ยนอะไหล่: 0 งาน</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-microchip"></i>
          </div>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white p-5 rounded-xl shadow-sm border border-slate-200">
          <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
              <i class="fa-solid fa-building-user text-indigo-600"></i> ยอดงานซ่อมแบ่งตามสาขา & การเปลี่ยนอะไหล่
            </h3>
          </div>
          <div class="h-64">
            <canvas id="branchJobChart"></canvas>
          </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
          <h3 class="font-bold text-slate-800 text-sm mb-4 flex items-center gap-2">
            <i class="fa-solid fa-chart-pie text-emerald-600"></i> สัดส่วนการรับประกัน
          </h3>
          <div class="h-48 relative flex items-center justify-center">
            <canvas id="warrantyDoughnutChart"></canvas>
          </div>
          <div class="mt-4 pt-3 border-t text-xs space-y-2">
            <div class="flex justify-between items-center">
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> ในประกัน</span>
              <span id="legend-in" class="font-bold">0 งาน</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span> นอกประกัน</span>
              <span id="legend-out" class="font-bold">0 งาน</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 2: สต็อก REAL-TIME -->
    <section id="view-stock" class="space-y-6 hidden">
      <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
        <div class="flex flex-wrap justify-between items-center gap-4 mb-4">
          <div>
            <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
              <i class="fa-solid fa-boxes-stacked text-indigo-600"></i> บัญชีสต็อกอะไหล่คงเหลือ (Real-time Balance)
            </h2>
            <p class="text-xs text-slate-500">คำนวณสดจากยอดรับเข้าหักลบยอดตัดจ่ายและใช้งานจริงทั้งหมด</p>
          </div>
          <div class="flex items-center gap-3">
            <input type="text" id="stock-search" oninput="renderStockTable()" placeholder="ค้นหารหัส หรือชื่ออะไหล่..." class="text-sm border border-slate-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-indigo-400">
            <button id="btn-export-csv" onclick="exportStockCSV()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-2 rounded-lg font-medium shadow flex items-center gap-1.5">
              <i class="fa-solid fa-file-excel"></i> Export CSV
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left border-collapse">
            <thead class="bg-slate-100 text-slate-600 text-xs uppercase">
              <tr>
                <th class="p-3">รหัสอะไหล่</th>
                <th class="p-3">ชื่ออะไหล่</th>
                <th class="p-3">รุ่นที่รองรับ</th>
                <th class="p-3 text-center">รับเข้ารวม</th>
                <th class="p-3 text-center">ตัดจ่ายรวม</th>
                <th class="p-3 text-center">คงเหลือพร้อมใช้</th>
                <th class="p-3 text-center">สถานะสต็อก</th>
              </tr>
            </thead>
            <tbody id="stock-table-tbody" class="divide-y divide-slate-200 text-xs">
              <!-- Loaded via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB 3: แคตตาล็อก & นำเข้า EXCEL -->
    <section id="view-catalog" class="space-y-6 hidden">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Form Add/Edit Part -->
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 h-fit">
          <div class="border-b pb-3 mb-4 flex justify-between items-center">
            <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
              <i class="fa-solid fa-folder-plus text-indigo-600"></i> <span id="catalog-form-title">เพิ่มรหัสสินค้า/อะไหล่</span>
            </h2>
            <button type="button" onclick="resetCatalogForm()" class="text-xs text-indigo-600 hover:underline">ล้างฟอร์ม</button>
          </div>

          <form id="catalog-form" onsubmit="handleCatalogSubmit(event)" class="space-y-3 text-xs">
            <input type="hidden" id="cat-mode" value="ADD">
            <div>
              <label class="block font-medium mb-1">รหัสอะไหล่ (Part ID / 物料编码) *</label>
              <input type="text" id="cat-id" required placeholder="เช่น DISP-IP16P-BLK" class="w-full border rounded-lg p-2 font-mono uppercase bg-slate-50 focus:bg-white">
            </div>
            <div>
              <label class="block font-medium mb-1">ชื่ออะไหล่ / สินค้า (货品名称) *</label>
              <input type="text" id="cat-name" required placeholder="เช่น หน้าจอ OLED iPhone 16 Pro แท้" class="w-full border rounded-lg p-2">
            </div>
            <div>
              <label class="block font-medium mb-1">รุ่นโทรศัพท์ที่รองรับ</label>
              <input type="text" id="cat-model" placeholder="เช่น iPhone 16 Pro / Vivo X100" class="w-full border rounded-lg p-2">
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-medium mb-1">หมวดหมู่อะไหล่</label>
                <select id="cat-category" class="w-full border rounded-lg p-2 bg-white">
                  <option value="หน้าจอ (Display)">หน้าจอ (Display)</option>
                  <option value="แบตเตอรี่ (Battery)">แบตเตอรี่ (Battery)</option>
                  <option value="กล้อง (Camera)">กล้อง (Camera)</option>
                  <option value="เมนบอร์ด (Mainboard)">เมนบอร์ด (Mainboard)</option>
                  <option value="พอร์ตชาร์จ/แพร (Flex/Port)">พอร์ตชาร์จ/แพร (Flex/Port)</option>
                  <option value="บอดี้/ฝาหลัง (Housing)">บอดี้/ฝาหลัง (Housing)</option>
                  <option value="อื่นๆ (Others)">อื่นๆ (Others)</option>
                </select>
              </div>
              <div>
                <label class="block font-medium mb-1">สต็อกขั้นต่ำเตือนภัย</label>
                <input type="number" id="cat-min" min="0" value="3" required class="w-full border rounded-lg p-2">
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block font-medium mb-1">ราคาทุนนำเข้า (บาท/THB)</label>
                <input type="number" id="cat-cost" min="0" step="0.01" placeholder="0" class="w-full border rounded-lg p-2">
              </div>
              <div>
                <label class="block font-medium mb-1">ราคาขายปลีก (บาท/THB)</label>
                <input type="number" id="cat-price" min="0" step="0.01" placeholder="0" class="w-full border rounded-lg p-2">
              </div>
            </div>

            <div class="pt-2">
              <button type="submit" id="btn-submit-catalog" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg shadow transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-floppy-disk"></i> บันทึกข้อมูลสินค้า
              </button>
            </div>
          </form>
        </div>

        <!-- Catalog List Table & Excel Import Bar -->
        <div class="lg:col-span-2 bg-white p-5 rounded-xl shadow-sm border border-slate-200">
          <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
            <div>
              <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-list-check text-indigo-600"></i> ฐานข้อมูลสินค้า & อะไหล่ทั้งหมด
              </h2>
              <p class="text-xs text-slate-500">รองรับการอัปโหลดไฟล์ Excel จากซัพพลายเออร์เพื่อนำเข้าข้อมูล</p>
            </div>
            
            <div class="flex items-center gap-2">
              <label class="cursor-pointer bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-2 rounded-lg font-medium shadow flex items-center gap-1.5 transition">
                <i class="fa-solid fa-file-excel"></i> นำเข้าไฟล์ Excel (Import)
                <input type="file" id="excel-file-input" accept=".xlsx, .xls" class="hidden" onchange="importPartsExcel(this)">
              </label>
              <input type="text" id="catalog-search" oninput="renderCatalogTable()" placeholder="ค้นหารหัส/ชื่อ..." class="text-xs border rounded-lg px-3 py-1.5 w-36">
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left border-collapse">
              <thead class="bg-slate-100 text-slate-600 uppercase">
                <tr>
                  <th class="p-2.5">รหัส (物料编码)</th>
                  <th class="p-2.5">ชื่ออะไหล่ (货品名称)</th>
                  <th class="p-2.5">หมวดหมู่</th>
                  <th class="p-2.5 text-right">ทุน (THB)</th>
                  <th class="p-2.5 text-right">ขายปลีก (THB)</th>
                  <th class="p-2.5 text-center">ขั้นต่ำ</th>
                  <th class="p-2.5 text-center">จัดการ</th>
                </tr>
              </thead>
              <tbody id="catalog-table-tbody" class="divide-y divide-slate-200">
                <!-- Loaded via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 4: บันทึกนำเข้า / ตัดสต็อกหลายรายการ -->
    <section id="view-multi-voucher" class="space-y-6 hidden">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <div class="border-b pb-4 mb-4 flex justify-between items-center">
          <div>
            <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
              <i class="fa-solid fa-receipt text-indigo-600"></i> บันทึกใบงานนำเข้า / ตัดจ่ายสต็อกอะไหล่ (หลายรหัสใน 1 ใบ)
            </h2>
            <p class="text-xs text-slate-500">ระบุสาขาต้นทาง-ปลายทาง และแนบรูปถ่ายบิลส่งของ</p>
          </div>
          <span class="text-xs font-mono bg-slate-100 px-3 py-1 rounded text-slate-600" id="voucher-code-preview">DOC-202610-001</span>
        </div>

        <form id="voucher-form" onsubmit="handleVoucherSubmit(event)">
          <!-- Document Header -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6 bg-slate-50 p-4 rounded-xl border border-slate-200">
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">ประเภทรายการ *</label>
              <select id="v-main-type" onchange="updateSubtypeOptions()" required class="w-full text-xs border rounded-lg p-2 bg-white">
                <option value="IN">นำเข้าสต็อก (+ รับเข้า)</option>
                <option value="OUT">ตัดสต็อก (- ตัดออก)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">ประเภทย่อย / วัตถุประสงค์ *</label>
              <select id="v-sub-type" required class="w-full text-xs border rounded-lg p-2 bg-white">
                <!-- Dynamic -->
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">สาขาต้นทาง (Source) *</label>
              <select id="v-source-branch" required class="w-full text-xs border rounded-lg p-2 bg-white">
                <option value="สำนักงานใหญ่ (HQ ประเทศไทย)">สำนักงานใหญ่ (HQ ประเทศไทย)</option>
                <option value="สาขาเวียงจันทน์">สาขาเวียงจันทน์</option>
                <option value="สาขาขอนแก่น">สาขาขอนแก่น</option>
                <option value="สาขาเชียงใหม่">สาขาเชียงใหม่</option>
                <option value="สาขากรุงเทพฯ">สาขากรุงเทพฯ</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">สาขาปลายทาง (Destination) *</label>
              <select id="v-dest-branch" required class="w-full text-xs border rounded-lg p-2 bg-white">
                <option value="สาขาเวียงจันทน์">สาขาเวียงจันทน์</option>
                <option value="สาขาขอนแก่น">สาขาขอนแก่น</option>
                <option value="สาขาเชียงใหม่">สาขาเชียงใหม่</option>
                <option value="สาขากรุงเทพฯ">สาขากรุงเทพฯ</option>
                <option value="สำนักงานใหญ่ (HQ ประเทศไทย)">สำนักงานใหญ่ (HQ ประเทศไทย)</option>
                <option value="ลูกค้าซ่อมหน้าร้าน">ลูกค้าซ่อมหน้าร้าน</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-700 mb-1">วันที่เอกสาร / สินค้ามาถึง *</label>
