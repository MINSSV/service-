    function removePartRow(btn) {
      const tbody = document.getElementById('multi-parts-tbody');
      if (!tbody) return;
      if (tbody.rows.length <= 1) {
        alert('ต้องมีรายการอะไหล่อย่างน้อย 1 รายการในเอกสาร');
        return;
      }
      btn.closest('tr').remove();
      Array.from(tbody.rows).forEach((row, idx) => {
        row.querySelector('.row-index').innerText = idx + 1;
      });
