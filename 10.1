          return;
        }

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 border-b";
        tr.innerHTML = `
          <td class="p-2.5 font-mono font-bold text-indigo-700">${p.id}</td>
          <td class="p-2.5 font-medium text-slate-800">${p.name}</td>
          <td class="p-2.5"><span class="badge bg-slate-100 text-slate-700">${p.category || '-'}</span></td>
          <td class="p-2.5 text-right font-mono text-slate-600">${(p.costThb || 0).toLocaleString()} ฿</td>
          <td class="p-2.5 text-right font-mono font-semibold text-emerald-600">${(p.price || 0).toLocaleString()} ฿</td>
          <td class="p-2.5 text-center font-bold text-amber-600">${p.minStock}</td>
          <td class="p-2.5 text-center space-x-1">
            <button onclick="editCatalogItem('${p.id}')" class="text-indigo-600 hover:text-indigo-800 p-1" title="แก้ไข"><i class="fa-solid fa-pen-to-square"></i></button>
            <button onclick="deleteCatalogItem('${p.id}')" class="text-red-500 hover:text-red-700 p-1" title="ลบ"><i class="fa-solid fa-trash-can"></i></button>
          </td>
        `;
        tbody.appendChild(tr);
