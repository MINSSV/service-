    // -------------------------------------------------------------
    // REAL-TIME STOCK CALCULATION
    // -------------------------------------------------------------
    function calculateStockBalance() {
      const balanceMap = {};

      masterParts.forEach(p => {
        balanceMap[p.id] = {
          id: p.id,
          name: p.name,
          model: p.model,
          minStock: p.minStock,
          totalIn: 0,
          totalOut: 0,
          currentStock: 0
        };
      });

      transactions.forEach(doc => {
        if (!doc.items) return;
        doc.items.forEach(item => {
          if (!balanceMap[item.partId]) {
            balanceMap[item.partId] = {
              id: item.partId,
              name: item.partName || item.partId,
              model: "-",
              minStock: 2,
              totalIn: 0,
              totalOut: 0,
              currentStock: 0
            };
          }
          const q = parseInt(item.qty, 10) || 0;
          if (doc.mainType === 'IN') {
            balanceMap[item.partId].totalIn += q;
          } else if (doc.mainType === 'OUT') {
            balanceMap[item.partId].totalOut += q;
          }
        });
      });

      Object.keys(balanceMap).forEach(id => {
        balanceMap[id].currentStock = balanceMap[id].totalIn - balanceMap[id].totalOut;
      });

      return balanceMap;
    }

    function renderStockTable() {
      const tbody = document.getElementById('stock-table-tbody');
      if (!tbody) return;
      const stockData = calculateStockBalance();
      const filter = (document.getElementById('stock-search')?.value || '').toLowerCase();
      tbody.innerHTML = '';

      Object.values(stockData).forEach(item => {
        if (filter && !item.id.toLowerCase().includes(filter) && !item.name.toLowerCase().includes(filter)) {
          return;
        }

        let statusBadge = '';
        if (item.currentStock <= 0) {
          statusBadge = '<span class="badge bg-red-100 text-red-700">สินค้าหมด (Out of Stock)</span>';
        } else if (item.currentStock <= item.minStock) {
          statusBadge = '<span class="badge bg-amber-100 text-amber-700">สต็อกต่ำกว่าเกณฑ์ (Low)</span>';
        } else {
          statusBadge = '<span class="badge bg-emerald-100 text-emerald-700">ปกติ พร้อมใช้งาน</span>';
        }

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 border-b';
        tr.innerHTML = `
          <td class="p-3 font-mono font-semibold text-indigo-700">${item.id}</td>
          <td class="p-3 font-medium text-slate-800">${item.name}</td>
          <td class="p-3 text-slate-500">${item.model}</td>
          <td class="p-3 text-center text-emerald-600 font-semibold">+${item.totalIn}</td>
          <td class="p-3 text-center text-red-500 font-semibold">-${item.totalOut}</td>
          <td class="p-3 text-center text-sm font-bold ${item.currentStock <= 0 ? 'text-red-600' : 'text-slate-800'}">${item.currentStock}</td>
          <td class="p-3 text-center">${statusBadge}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function exportStockCSV() {
      const stock = calculateStockBalance();
      let csv = "รหัสอะไหล่ (物料编码),ชื่ออะไหล่ (货品名称),รุ่นที่รองรับ,รับเข้ารวม,ตัดจ่ายรวม,คงเหลือพร้อมใช้\n";
      Object.values(stock).forEach(s => {
        csv += `"${s.id}","${s.name}","${s.model}",${s.totalIn},${s.totalOut},${s.currentStock}\n`;
      });
      const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Stock_Report_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
    }

